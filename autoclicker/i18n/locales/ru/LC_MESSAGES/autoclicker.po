#: autoclicker/gui/controller.py:72
msgid "Coordinates must be integers and delays cannot be negative."
msgstr ""
"Координаты должны быть целыми числами, а задержки не могут быть "
"отрицательными."

#: autoclicker/gui/controller.py:79
msgid "The selected point no longer exists."
msgstr "Выбранная точка больше не существует."

#: autoclicker/gui/controller.py:96
msgid "Mesh generation requires exactly three points."
msgstr "Для создания сетки необходимо ровно три точки."

#: autoclicker/gui/controller.py:98
msgid "Mesh width and height must both be greater than 1."
msgstr "Ширина и высота сетки должны быть больше 1."

#: autoclicker/gui/controller.py:149
msgid "Global hotkeys are not initialized."
msgstr "Глобальные горячие клавиши не инициализированы."

#: autoclicker/gui/controller.py:161
#, python-brace-format
msgid "Could not apply settings: {error}"
msgstr "Не удалось применить настройки: {error}"

#: autoclicker/gui/controller.py:167
msgid "Settings applied successfully."
msgstr "Настройки успешно применены."

#: autoclicker/gui/controller.py:201
msgid "Another automation mode is already running."
msgstr "Другой режим автоматизации уже запущен."

#: autoclicker/gui/controller.py:204
msgid "Record or load at least one point first."
msgstr "Сначала запишите или загрузите хотя бы одну точку."

#: autoclicker/gui/controller.py:218
#, python-brace-format
msgid "Could not save points: {error}"
msgstr "Не удалось сохранить точки: {error}"

#: autoclicker/gui/controller.py:242
#, python-brace-format
msgid "Automation stopped because of an error: {error}"
msgstr "Автоматизация остановлена из-за ошибки: {error}"


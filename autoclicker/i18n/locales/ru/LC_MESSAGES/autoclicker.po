msgid "First action"
msgstr "Первое действие"

#: autoclicker/gui/panels/settings.py:108
msgid "Second action"
msgstr "Второе действие"

#: autoclicker/gui/panels/settings.py:156
msgid "Points across"
msgstr "Точек по ширине"

#: autoclicker/gui/panels/settings.py:157
msgid "Points down"
msgstr "Точек по высоте"

#: autoclicker/gui/panels/settings.py:162
msgid ""
"Mesh generation uses exactly three recorded points: origin, horizontal "
"extent, and vertical extent."
msgstr ""
"Для создания сетки используются ровно три записанные точки: начало, "
"горизонтальная граница и вертикальная граница."

#: autoclicker/gui/panels/settings.py:168
msgid "Create mesh"
msgstr "Создать сетку"

#: autoclicker/gui/panels/settings.py:193
#: autoclicker/gui/panels/settings.py:222
msgid "Use one key or one simultaneous combination, for example ctrl+alt+s."
msgstr ""
"Используйте одну клавишу или одну одновременную комбинацию, например "
"ctrl+alt+s."


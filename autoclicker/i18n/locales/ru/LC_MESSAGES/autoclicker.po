#: autoclicker/gui/panels/settings.py:99
msgid "Target blue"
msgstr "Целевой синий"

#: autoclicker/gui/panels/settings.py:101
msgid "Delay between frames (ms)"
msgstr "Задержка между кадрами (мс)"

#: autoclicker/gui/panels/settings.py:103
msgid "Action cooldown (ms)"
msgstr "Интервал между действиями (мс)"

#: autoclicker/gui/panels/settings.py:105
msgid "Second action delay (ms)"
msgstr "Задержка второго действия (мс)"


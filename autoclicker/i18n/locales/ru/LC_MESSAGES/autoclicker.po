msgstr "Компьютерное зрение"

#: autoclicker/gui/panels/settings.py:245
msgid "Mesh"
msgstr "Сетка"

#: autoclicker/gui/panels/settings.py:246
msgid "Hotkeys"
msgstr "Горячие клавиши"

#: autoclicker/gui/panels/settings.py:251
msgid "Restore all defaults"
msgstr "Восстановить все настройки"

#: autoclicker/gui/panels/settings.py:252
msgid "Apply settings"
msgstr "Применить настройки"

#: autoclicker/i18n/messages.py:7
msgid "About Autoclicker"
msgstr "О программе Autoclicker"

#: autoclicker/i18n/messages.py:8
msgid "Local automation for recorded screen points and exact-color CV actions."
msgstr ""
"Локальная автоматизация записанных точек экрана и CV-действий по точному "
"цвету."

#: autoclicker/i18n/messages.py:9
msgid "Version"
msgstr "Версия"

#: autoclicker/i18n/messages.py:10
msgid "Close"
msgstr "Закрыть"

#: autoclicker/i18n/messages.py:11
#, python-brace-format
msgid "Global hotkeys could not be registered: {error}"
msgstr "Не удалось зарегистрировать глобальные горячие клавиши: {error}"

#: autoclicker/i18n/messages.py:12
#, python-brace-format
msgid "The default points file could not be loaded: {error}"
msgstr "Не удалось загрузить файл точек по умолчанию: {error}"

#: autoclicker/i18n/messages.py:13
#, python-brace-format
msgid "{count} point"
msgid_plural "{count} points"
msgstr[0] "{count} точка"
msgstr[1] "{count} точки"
msgstr[2] "{count} точек"

#: autoclicker/i18n/messages.py:15
msgid "Language must be English or Russian."
msgstr "Язык должен быть английским или русским."

#: autoclicker/i18n/messages.py:16
msgid "Delay before a click cannot be negative."
msgstr "Задержка перед кликом не может быть отрицательной."

#: autoclicker/i18n/messages.py:17
msgid "Delay after a click cannot be negative."
msgstr "Задержка после клика не может быть отрицательной."

#: autoclicker/i18n/messages.py:18
msgid "Mesh width must be greater than 1."
msgstr "Ширина сетки должна быть больше 1."

#: autoclicker/i18n/messages.py:19
msgid "Mesh height must be greater than 1."
msgstr "Высота сетки должна быть больше 1."

#: autoclicker/i18n/messages.py:20
msgid "CV region width must be greater than 0."
msgstr "Ширина области CV должна быть больше 0."

#: autoclicker/i18n/messages.py:21
msgid "CV region height must be greater than 0."
msgstr "Высота области CV должна быть больше 0."

#: autoclicker/i18n/messages.py:22
msgid "RGB values must be between 0 and 255."
msgstr "Значения RGB должны быть от 0 до 255."

#: autoclicker/i18n/messages.py:23
msgid "CV timing values cannot be negative."
msgstr "Значения времени CV не могут быть отрицательными."

#: autoclicker/i18n/messages.py:24
msgid "Hotkeys cannot be empty."
msgstr "Горячие клавиши не могут быть пустыми."

#: autoclicker/i18n/messages.py:25
msgid "Unsupported hotkey."
msgstr "Неподдерживаемая горячая клавиша."

#: autoclicker/i18n/messages.py:26
msgid "Hotkey duplicates another action."
msgstr "Горячая клавиша уже назначена другому действию."

#: autoclicker/i18n/messages.py:27
msgid "CV actions cannot be empty."
msgstr "Действия CV не могут быть пустыми."

#: autoclicker/i18n/messages.py:28
msgid "Unsupported CV action."
msgstr "Неподдерживаемое действие CV."


msgstr "Изменение языка вступит в силу после перезапуска приложения."

#: autoclicker/gui/panels/settings.py:53
msgid "Default delay before click (ms)"
msgstr "Задержка перед кликом по умолчанию (мс)"

#: autoclicker/gui/panels/settings.py:59
msgid "Default delay after click (ms)"
msgstr "Задержка после клика по умолчанию (мс)"

